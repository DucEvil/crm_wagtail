# Sao chép file này thành .env.analytics rồi thay toàn bộ mật khẩu trước khi dùng.
POSTGRES_DB=smartcrm
POSTGRES_ADMIN_PASSWORD=change-me-cluster-admin
APP_DB_USER=smartcrm_app
APP_DB_PASSWORD=change-me-app-db

ANALYTICS_DB_USER=smartcrm_analytics
ANALYTICS_DB_PASSWORD=change-me-read-only

SUPERSET_META_DB=superset
SUPERSET_META_USER=superset_meta
SUPERSET_META_PASSWORD=change-me-superset-meta
SUPERSET_SECRET_KEY=replace-with-a-long-random-secret-at-least-42-characters

CRM_ADMIN_USERNAME=admin
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=change-me-crm-admin
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=change-me-superset-admin

CRM_PORT=8000
SUPERSET_PORT=8088
POSTGRES_PORT=5433
SUPERSET_PUBLIC_URL=http://localhost:8088
# Configure AI_PROVIDER and API keys in .env; CRM loads that file directly.
